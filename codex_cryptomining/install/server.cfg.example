# ---------------------------------------------------------------------------
# codex_cryptomining - server.cfg
# ---------------------------------------------------------------------------

# Start order matters: the framework and the database first.
# These two are the ONLY hard requirements.
ensure oxmysql
ensure es_extended

# Optional integrations (start them before the resource if you use them).
# The resource ships its OWN notifications, progress bar and skillcheck, so
# ox_lib is NOT required. ox_inventory and ox_target are auto-detected and
# used if present, otherwise the built-in inventory / text-UI fallbacks run.
ensure ox_inventory   # optional
ensure ox_target      # optional
# ensure ox_lib       # optional, only if you set the *.Type options to 'ox_lib'

# The resource itself.
ensure codex_cryptomining

# ---------------------------------------------------------------------------
# ONESYNC (strongly recommended)
# ---------------------------------------------------------------------------
# Server side distance checks only work with OneSync enabled. Without it the
# resource still runs, but those anti-cheat checks are skipped and a warning
# is printed on startup.
set onesync on

# ---------------------------------------------------------------------------
# ADMIN PERMISSION
# ---------------------------------------------------------------------------
# Required to use /crypto (price, reset, info, setowner).
add_ace group.admin codex_cryptomining.admin allow

# Give it to a specific player instead:
# add_principal identifier.license:XXXXXXXXXXXXXXXX group.admin
